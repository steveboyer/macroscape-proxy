{
  "name": "macroscape-proxy",
  "version": "0.0.0",
  "private": true,
  "description": "AWS Lambda proxy for the MacroScape iOS app",
  "license": "MIT",
  "author": "Steve Boyer",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cdk": "cdk",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^26.5.1",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "~3.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1048.0",
    "@aws-sdk/client-secrets-manager": "^3.1048.0",
    "@aws-sdk/lib-dynamodb": "^3.1048.0",
    "aws-cdk-lib": "^2.269.0",
    "constructs": "^10.6.0",
    "jose": "^6.2.3"
  },
  "lint-staged": {
    "*.{ts,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
